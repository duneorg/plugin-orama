{
  "name": "@dune/plugin-orama",
  "version": "1.0.4",
  "license": "MIT",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@dune/core"]
  },
  "exports": {
    ".": "./src/mod.ts",
    "./plugin": "./src/plugin.ts",
    "./engine": "./src/engine.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@dune/core": "jsr:@dune/core@0.34",
    "@dune/core/search": "jsr:@dune/core@0.34/search",
    "@dune/core/hooks": "jsr:@dune/core@0.34/hooks",
    "@orama/orama": "npm:@orama/orama@^3"
  },
  "tasks": {
    "test": "deno test --allow-env tests/",
    "check": "deno fmt --check && deno lint && deno check src/**/*.ts tests/**/*.ts"
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
