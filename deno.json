{
  "name": "@dune/plugin-orama",
  "version": "1.1.0",
  "license": "MIT",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@dune/plugin-api"]
  },
  "exports": {
    ".": "./src/mod.ts",
    "./plugin": "./src/plugin.ts",
    "./engine": "./src/engine.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@dune/plugin-api": "jsr:@dune/plugin-api@^1.2.0",
    "@orama/orama": "npm:@orama/orama@^3"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read tests/",
    "check": "deno fmt --check && deno lint && deno check src/**/*.ts tests/**/*.ts"
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
